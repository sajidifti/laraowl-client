{
    "name": "laraowl/client",
    "description": "Laraowl monitoring client for Laravel applications.",
    "keywords": [
        "laravel",
        "monitoring",
        "laraowl"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "ext-zlib": "*",
        "guzzlehttp/promises": "^2.0|^3.0",
        "laravel/framework": "^13.0",
        "monolog/monolog": "^3.6",
        "nesbot/carbon": "^3.0",
        "psr/http-message": "^2.0",
        "psr/log": "^3.0",
        "ramsey/uuid": "^4.0",
        "symfony/console": "^8.0",
        "symfony/http-foundation": "^8.0"
    },
    "require-dev": {
        "ext-pcntl": "*",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.0|^8.0",
        "guzzlehttp/psr7": "^2.0|^3.0",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^13.0",
        "symfony/var-dumper": "^8.0"
    },
    "autoload": {
        "psr-4": {
            "Laraowl\\Client\\": "src/"
        }
    },
    "scripts": {
        "lint": [
            "@php vendor/bin/phpstan --memory-limit=-1 --verbose",
            "@php vendor/bin/pint --cache-file=.pint.cache"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Laraowl\\Client\\LaraowlClientServiceProvider"
            ],
            "aliases": {
                "LaraowlClient": "Laraowl\\Client\\Facades\\LaraowlClient"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "audit": {
            "block-insecure": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
